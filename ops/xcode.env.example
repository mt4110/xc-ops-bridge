# ops/xcode.env (TEMPLATE)
# - Track this file in git.
# - Copy to ops/xcode.env (ignored) and edit locally.

# Choose ONE: workspace OR project
XCODE_WORKSPACE="YourApp.xcworkspace"
XCODE_PROJECT=""

XCODE_SCHEME="YourApp"
XCODE_CONFIGURATION="Debug"

# Default (quiet): macOS Apple Silicon
XCODE_DESTINATION="platform=macOS,arch=arm64"

# iOS example:
# XCODE_DESTINATION="platform=iOS Simulator,name=iPhone 16,OS=latest"

# Keep build outputs in .local (gitignored)
XCODE_DERIVED_DATA=".local/xcode/DerivedData"
XCODE_RESULT_BUNDLE=".local/xcode/TestResults.xcresult"
